# Copy this file to .env and fill in your own values. Never commit .env.

# =====================================================================
# xrp_futures live bot — Binance USDⓈ-M Futures (multi-asset, 8 coins)
# =====================================================================

# testnet (default, fake money) or production (real money).
# Independent from the legacy bot's ENVIRONMENT below.
FUTURES_ENVIRONMENT=testnet

# Futures TESTNET keys: create them at https://testnet.binancefuture.com
# (a separate account from the Spot testnet keys further down).
FUTURES_TESTNET_API_KEY=your_futures_testnet_api_key
FUTURES_TESTNET_SECRET=your_futures_testnet_api_secret

# =====================================================================
# Production Binance keys (shared by both bots)
# =====================================================================
# For the futures bot, create a key with ONLY "Enable Futures" checked:
#   - Spot & Margin trading: OFF  (the bot must never touch your Spot holdings)
#   - Withdrawals:           OFF
# check_futures_connectivity warns if either is enabled.
BINANCE_API_KEY=your_production_api_key
BINANCE_SECRET=your_production_api_secret

# =====================================================================
# Legacy spot grid bot (legacy/spot_grid_bot) — frozen, not used by xrp_futures
# =====================================================================

# Spot testnet keys (https://testnet.binance.vision)
TESTNET_API_KEY=your_testnet_api_key
TESTNET_SECRET=your_testnet_api_secret

# Environment: testnet or production
ENVIRONMENT=testnet

# Trading pair
SYMBOL=ETHUSDT

# Base grid configuration
GRID_SPREAD_PCT=10
GRID_LEVELS=10
CAPITAL_USDT=100

# Adaptive grid configuration
GRID_ADAPTIVE=true
GRID_SPREAD_MIN_PCT=6
GRID_SPREAD_MAX_PCT=10
GRID_ATR_SPREAD_MULT=3.0
GRID_ADX_SIDEWAYS_MAX=28
GRID_ADX_STRONG_TREND=32
GRID_SIDEWAYS_SPREAD_SCALE=1.03
GRID_STRONG_TREND_SPREAD_SCALE=0.82
GRID_GEOMETRIC=true

# Inventory and grid relocation controls
MAX_BASE_INVENTORY_PCT=88
RELOCATE_THRESHOLD_PCT=8
RELOCATE_COOLDOWN_SEC=300

# Fixed grid bounds fallback
GRID_UPPER=3500
GRID_LOWER=2500

# Risk management
STOP_LOSS_PCT=0.05
MAX_ORDER_SIZE=50
ADX_PAUSE_THRESHOLD=35
FEE_RATE=0.001
RESERVE_ETH_PCT=0
